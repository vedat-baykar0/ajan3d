# Bu dosyayi .env olarak kopyalayip doldurun.
# Zorunlu olan tek anahtar: ANTHROPIC_API_KEY. Geri kalan her ayarin
# calisan bir varsayilani var.
#
# console.anthropic.com -> API Keys
# (DIKKAT: Anthropic'in ucretsiz katmani yoktur, token basina ucretlidir)
ANTHROPIC_API_KEY=sk-ant-...

OUTPUT_LANGUAGE=Turkce


# ===========================================================================
# 1. TANIMA AJANI (Vision) — urunun teknik kimligini cikarir
# ===========================================================================
# Fotograf YALNIZCA tanima icin kullanilir; 3D geometri uretilmez.
# Belirleyici olan damgalarin (CF8M, DN50, 1000 WOG) okunabilmesidir,
# bu yuzden eskiye gore daha cok ve daha buyuk fotograf gonderilir.
#
# claude-sonnet-5-5 (varsayilan, $2/$10 per 1M token)
# claude-haiku-5-5  (~18x daha ucuz: $0.10/$0.50) | claude-opus-5-5 ($4/$20)
VISION_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
VISION_EFFORT=low
# Tanimaya gonderilecek en fazla fotograf sayisi.
# 3 kare urunu tanimaya yetiyor ama AYRINTIYA yetmiyor: musterinin
# sekiz fotografinda montaj pabucunun kare ve 8 delikli oldugu yalnizca
# tepeden cekilen karede goruluyordu ve o kare ilk uc temsilcinin
# arasinda degildi. Kare basina ~1300 gorsel token.
VISION_MAX_IMAGES=6
# Gonderimden once uzun kenarin kuculturulecegi piksel degeri
VISION_MAX_SIDE=1280
# Urun guvenle taninamadiginda ne olsun: false = is operatore birakilir,
# true = yine de devam edilir (temsili model cikabilir)
FORCE_LOW_CONFIDENCE=false


# ===========================================================================
# 2. TEKNIK VERI AJANI (Claude + web_search) — UCRETLI, kapatilabilir
# ===========================================================================
# Urunun katalog verilerini, standartlarini ve STANDART PARCA LISTESINI
# internetten toplar (fotografta gorunmeyen oturma, salmastra, yay dahil).
# Olculen maliyet: is basina ~$0.11-0.16 (3-4 arama + token).
# Kapatmak icin: SPEC_ENABLED=false  -> zincir tanima ciktisiyla devam eder,
# model yine kurulur, yalnizca teknik ozellik tablosu zayiflar.
SPEC_ENABLED=true
SPEC_MODEL=claude-sonnet-5-5
SPEC_EFFORT=low
SPEC_MAX_SEARCHES=4


# ===========================================================================
# 3. CAD EDINME — yerel, ucretsiz, agsiz
# ===========================================================================
# Kaynak sirasi. Soldan saga denenir, ilk basaran kullanilir:
#   local      cad_library\<klasor>\model.glb + manifest.json
#   remote     CAD_API_URL (asagida) — varsayilan kapali
#   parametric EN 1092-1 / ISO 5211 tablolarindan kurulan Boolean kati montaj
# Parametrik yol HER ZAMAN calisir; en sona konmasi sarttir.
CAD_SOURCES=local,parametric

# Uzak katalog SOZLESMESI (istege bagli):
#   CAD_API_URL icindeki {query} aranan ifadeyle degistirilir, adres JSON
#   dondurur ve yanitin herhangi bir yerinde .glb ile biten bir indirme
#   baglantisi bulunur. Gerekiyorsa CAD_API_TOKEN Authorization basligi olur.
#
# NOT: GrabCAD'in acik indirme API'si YOKTUR (oturum ister, icerik yeniden
# dagitilamaz). Thangs'in API'si anahtarla kapalidir ve icerigi cogunlukla
# STEP/SLDPRT'tir — .glb degildir ve parcalari adlandirilmis gelmez. Bu yuzden
# belirli bir saglayici koda gomulmedi; anahtariniz olan servisi buraya yazin.
CAD_API_URL=
CAD_API_TOKEN=
CAD_API_TIMEOUT=25


# ===========================================================================
# 4. SUNUM
# ===========================================================================
# Sentetik studyo HDRI. Metalik yuzeyin "celik gibi" gorunmesi dokudan degil
# yansidigi ortamdan gelir; LDR bir ortam gorseli metalde sonuk gri verir.
HDRI_ENABLED=true
HDRI_WIDTH=1024
# Sag paneldeki musteri fotografinin uzun kenari (px)
PHOTO_MAX_SIDE=1100


# ===========================================================================
# 5. AJANS OTOMASYONU (run_agency.py)
# ===========================================================================
# Yonetim paneli: YALNIZCA bu bilgisayardan acilir, tunele baglanmaz.
AGENCY_HOST=127.0.0.1
AGENCY_PORT=8000
# Yayin sunucusu: paketleri servis eder, tunel SADECE bunu disariya acar.
# Ayri port olmasi sart; yoksa yonetim paneli de internete sizar.
PUBLISH_HOST=127.0.0.1
PUBLISH_PORT=8001
# Bos birakin: link canli tunelden otomatik turetilir.
PUBLIC_BASE_URL=
AGENCY_LANG=tr
# Yarim kalan isi kac kez tekrar denesin (hiz siniri icin)
AGENCY_MAX_ATTEMPTS=4
AGENCY_RETRY_SECONDS=1800
# Periyodik inbox taramasi (watchdog yedegi)
AGENCY_SCAN_SECONDS=10
AGENCY_SETTLE_SECONDS=5


# ===========================================================================
# 6. PUBLIC LINK (tunel)
# ===========================================================================
# cloudflared: hesap gerekmez, proje icinde hazir (tools\bin\cloudflared.exe).
# Her baslatmada adres degisir. ngrok icin TUNNEL_PROVIDER=ngrok + NGROK_AUTHTOKEN.
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=cloudflared
# Kalici adresiniz varsa (kendi alan adi / adli cloudflare tuneli) buraya yazin;
# o zaman link HIC degismez ve musteriye verilen eski linkler calismaya devam eder.
TUNNEL_HOSTNAME=
TUNNEL_START_TIMEOUT=45
# CLOUDFLARED_PATH=
# NGROK_PATH=
# NGROK_AUTHTOKEN=


# ===========================================================================
# 7. BILDIRIM (SMTP) — TAMAMEN ISTEGE BAGLI
# ===========================================================================
# Bos birakin; sistem calisir, sonuc 3D_SONUC.txt olarak fotograf klasorune
# yazilir ve public link panoya kopyalanir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Hatalar bu adrese gider (musteriye asla hata gonderilmez)
OPERATOR_EMAIL=


# ===========================================================================
# 8. KLASOR YOLLARI — istege bagli, varsayilan proje icindedir
# ===========================================================================
# INBOX_DIR=
# JOBS_DIR=
# PUBLIC_DIR=
# LOG_DIR=


# ===========================================================================
# 9. WEB OPTIMIZASYONU (Draco) — istege bagli
# ===========================================================================
# Parametrik montaj dokusuz; boyutun tamami kose/indeks verisi oldugu icin
# Draco ~%88 kazandiriyor (olculdu: 994 KB -> 121 KB). Karsiliginda tarayici
# ~250 KB wasm cozucu indiriyor, bu yuzden esigin altindaki modeller
# sikistirilmaz: kucuk modelde sikistirmak toplam indirmeyi ARTIRIR.
#
# Kurulum (istege bagli, yoksa zincir sikistirmasiz calisir):
#   cd tools\node  &&  npm install
DRACO_ENABLED=true
DRACO_MIN_BYTES=400000
