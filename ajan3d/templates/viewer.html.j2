{#
  Endüstriyel ürün sunum sayfası — Three.js.

  Sayfanın taşıdığı sözleşme GLB'den gelir: her parça düğümü `extras` içinde
  pid (parça kimliği), grp (X-Ray grubu), ax (montaj ekseni), d (mesafe
  çarpanı) ve st (patlatma aşaması) taşır. Patlatma bu yüzden bir efekt değil,
  montaj sırasının geri oynatılmasıdır.

  Üç sunum kararı:
  * Parçalama tarayıcıda hesaplanır (GLB'ye animasyon gömülmez). Böylece
    kaydırıcı sürekli, aşamalar gecikmeli ve yön her parçanın kendi eksenidir.
  * X-Ray yalnızca `grp == "housing"` parçalarını saydamlaştırır; iç mekanizma
    opak kalır ve kenar çizgileri eklenir — kesit almadan içeriyi göstermenin
    en okunur yolu.
  * Malzemeler yüklemede klonlanır. Aynı malzemeyi paylaşan iki parça (gövde
    ve kapak) aksi halde X-Ray'de birlikte saydamlaşırdı.
#}<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ identity.product_name }}{% if cad.params and cad.params.dn %} · DN{{ cad.params.dn }}{% endif %}</title>
{# Gömülü simge: paketin tek dış isteği buydu ve her açılışta konsola
   404 düşüyordu. Veri adresi olarak gömmek hem isteği hem hatayı siler. #}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230f1821'/%3E%3Cpath d='M6 19h20M16 19V9M10 23h12' stroke='%235da8e0' stroke-width='2.6' stroke-linecap='round' fill='none'/%3E%3Ccircle cx='16' cy='7' r='3' fill='%235da8e0'/%3E%3C/svg%3E">
<meta name="description" content="{{ identity.summary|truncate(180) }}">
<style>
:root{
  --bg:#080a0d; --bg2:#0e1116; --panel:#11151b; --panel2:#161b22;
  --line:#222933; --line2:#2d3643;
  --text:#e9eef5; --dim:#8c97a6; --dim2:#616c7c;
  --accent:#4cb3e4; --accent2:#2a7fa8; --amber:#e8a33d; --ok:#4ec08a;
  --r:10px; --mono:ui-monospace,SFMono-Regular,"JetBrains Mono",Consolas,monospace;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--text);overflow:hidden;
  font:14px/1.55 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  -webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}

/* ---------- yerleşim ---------- */
#app{display:grid;height:100%;
  grid-template-rows:auto 1fr;
  grid-template-columns:1fr 374px;
  grid-template-areas:"head head" "stage panel"}
/* Başlık şeridi bilinçli olarak ALÇAK: sayfanın işi ürünü göstermek, metni
   değil. Önceki yükseklikte (iki satır başlık + alt başlık + şerit) tuval
   masaüstünde ekranın %70'ine iniyordu; ürün küçük ve uzak duruyordu. */
header{grid-area:head;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:7px 18px;background:linear-gradient(180deg,#10141a,#0c1014);
  border-bottom:1px solid var(--line)}
#stage{grid-area:stage;position:relative;overflow:hidden;
  background:#06080b}
aside{grid-area:panel;background:var(--panel);border-left:1px solid var(--line);
  overflow-y:auto;overscroll-behavior:contain}

/* ---------- başlık ---------- */
.title{min-width:220px;flex:1 1 320px}
.eyebrow{font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;
  color:var(--accent);font-weight:600;margin-bottom:1px}
h1{margin:0;font-size:clamp(14px,1.6vw,17px);font-weight:600;letter-spacing:-.01em;
  line-height:1.25}
/* Alt başlık özet metnini tekrarlıyordu; yan panelde zaten var. */
.subtitle{display:none}
.chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.chip{display:flex;flex-direction:column;gap:0;padding:3px 9px;border-radius:7px;
  background:#161c24;border:1px solid var(--line2);min-width:68px}
.chip b{font:600 13px/1.25 var(--mono);letter-spacing:.01em}
.chip span{font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--dim2)}
.badge{padding:4px 10px;border-radius:999px;font-size:11px;font-weight:600;
  border:1px solid}
.badge.rep{color:var(--amber);border-color:#5a4418;background:#201909}

/* ---------- sahne ---------- */
canvas{display:block;width:100%;height:100%;outline:none}
#overlay{position:absolute;inset:0;pointer-events:none}
#leaders{position:absolute;inset:0;width:100%;height:100%}
.label{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;
  padding:3px 9px;border-radius:7px;font:500 11.5px/1.3 var(--mono);
  background:rgba(14,18,24,.92);border:1px solid var(--line2);color:var(--text);
  pointer-events:auto;cursor:pointer;backdrop-filter:blur(4px);
  transition:border-color .15s,color .15s}
.label:hover,.label.on{border-color:var(--accent);color:var(--accent)}
/* Telefonda 20 etiket tek oluğa diziliyor; küçülmezse kadrajı kaplıyorlar. */
@media (max-width:719px){.label{font-size:10px;padding:2px 6px}}
.label i{color:var(--dim2);font-style:normal;margin-right:5px}
.dot{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--accent);
  transform:translate(-50%,-50%);box-shadow:0 0 0 2px rgba(76,179,228,.22)}

#hint{position:absolute;left:50%;top:9px;transform:translateX(-50%);
  color:var(--dim2);font-size:11.5px;letter-spacing:.02em;pointer-events:none;
  transition:opacity .5s}
#scalebar{position:absolute;left:18px;bottom:104px;color:var(--dim2);
  font:11px/1 var(--mono);pointer-events:none}
#scalebar .bar{height:1px;background:var(--dim2);margin-bottom:5px;
  border-left:1px solid var(--dim2);border-right:1px solid var(--dim2);
  box-sizing:content-box;padding:3px 0 0}

#loader{position:absolute;inset:0;display:grid;place-content:center;gap:16px;
  justify-items:center;background:var(--bg);z-index:5;transition:opacity .5s;
  padding:24px;text-align:center}
#loader.gone{opacity:0;pointer-events:none}
.ring{width:30px;height:30px;border:2px solid var(--line2);border-top-color:var(--accent);
  border-radius:50%;animation:spin .9s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#loader p{margin:0;color:var(--dim);font:12px/1.4 var(--mono)}
/* Gerçek ilerleme çubuğu: indirilen bayt / bilinen dosya boyutu. */
#track{width:min(260px,70vw);height:3px;border-radius:3px;background:var(--line2);
  overflow:hidden}
#fill{height:100%;width:0%;border-radius:3px;
  background:linear-gradient(90deg,var(--accent2),var(--accent));
  transition:width .22s cubic-bezier(.22,.61,.36,1)}
#loader.indeterminate #fill{width:35%;animation:slide 1.1s ease-in-out infinite}
@keyframes slide{0%{margin-left:-35%}100%{margin-left:100%}}
#lpct{font:600 13px/1 var(--mono);color:var(--text)}
#lphase{font-size:11.5px;letter-spacing:.06em;color:var(--dim2)}
#loader.failed{gap:0}
#loader.failed .ring,#loader.failed #track,#loader.failed #lpct{display:none}
.err-box{max-width:420px;border:1px solid #5a2a2a;background:#1c1012;border-radius:12px;
  padding:18px 20px;text-align:left}
.err-box h3{margin:0 0 7px;font-size:14px;color:#f08c8c;font-weight:600}
.err-box p{margin:0 0 10px;color:var(--dim);font:12.5px/1.5 ui-sans-serif,system-ui}
.err-box pre{margin:0 0 12px;padding:9px 10px;background:#120b0c;border-radius:7px;
  color:var(--dim2);font:10.5px/1.5 var(--mono);white-space:pre-wrap;max-height:120px;
  overflow:auto}
.err-box button{padding:8px 15px;border-radius:8px;background:#2a1718;color:#f0a0a0;
  border:1px solid #5a2a2a;font-size:12.5px;cursor:pointer}
.err-box button:hover{background:#361c1e}
/* Sahne yalnızca her şey hazır olduğunda belirir. */
#view{opacity:0;transition:opacity .55s ease-out}
#view.ready{opacity:1}

/* ---------- alt kumanda paneli ---------- */
#dock{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);
  display:flex;align-items:center;gap:6px;padding:8px;max-width:calc(100% - 28px);
  background:rgba(13,17,22,.86);border:1px solid var(--line2);border-radius:14px;
  backdrop-filter:blur(14px);box-shadow:0 14px 44px rgba(0,0,0,.6);
  overflow-x:auto;scrollbar-width:none}
#dock::-webkit-scrollbar{display:none}
.tool{display:flex;align-items:center;gap:7px;padding:8px 13px;border-radius:9px;
  font-size:12.5px;font-weight:500;color:var(--dim);white-space:nowrap;
  border:1px solid transparent;transition:background .15s,color .15s,border-color .15s}
/* `display:flex` tarayıcının [hidden] kuralını eziyor: projeksiyon
   kapalıyken gizlenmesi gereken "Foto doku" düğmesi yine de görünüyor ve
   basınca hiçbir şey yapmıyordu. */
.tool[hidden]{display:none}
.tool:hover{background:#1a212a;color:var(--text)}
.tool.on{background:rgba(76,179,228,.15);color:var(--accent);border-color:#2b5f7a}
.tool svg{width:15px;height:15px;flex:none}
.sep{width:1px;height:24px;background:var(--line2);margin:0 3px;flex:none}
.slide{display:flex;align-items:center;gap:9px;padding:0 10px 0 4px}
.slide input{-webkit-appearance:none;appearance:none;width:116px;height:3px;
  border-radius:3px;background:var(--line2);outline:none}
.slide input::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;
  border-radius:50%;background:var(--accent);cursor:pointer;
  box-shadow:0 0 0 3px rgba(76,179,228,.2)}
.slide input::-moz-range-thumb{width:14px;height:14px;border:0;border-radius:50%;
  background:var(--accent);cursor:pointer}
.slide b{font:600 11.5px/1 var(--mono);color:var(--dim);min-width:34px;text-align:right}

/* ---------- sağ panel ---------- */
section{border-bottom:1px solid var(--line);padding:16px 18px}
section:last-child{border-bottom:0}
h2{margin:0 0 11px;font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;
  color:var(--dim2);font-weight:600}
.photo{position:relative;border-radius:var(--r);overflow:hidden;background:#06080b;
  border:1px solid var(--line)}
.photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.thumbs{display:flex;gap:6px;margin-top:7px}
.thumbs img{width:52px;height:40px;object-fit:cover;border-radius:6px;cursor:pointer;
  border:1px solid var(--line);opacity:.55;transition:opacity .15s,border-color .15s}
.thumbs img:hover,.thumbs img.on{opacity:1;border-color:var(--accent)}
.caption{color:var(--dim2);font-size:11px;margin-top:7px}

table{width:100%;border-collapse:collapse;font-size:12.5px}
td{padding:6px 0;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:0}
td.k{color:var(--dim);width:45%;padding-right:12px}
td.v{font-family:var(--mono);font-size:12px}

.part{display:flex;align-items:center;gap:10px;width:100%;padding:7px 8px;
  border-radius:8px;text-align:left;transition:background .13s}
.part:hover{background:#171d25}
.part.on{background:rgba(76,179,228,.13);outline:1px solid #2b5f7a}
.part .no{font:600 10.5px/1 var(--mono);color:var(--dim2);width:19px;flex:none}
.part .sw{width:9px;height:9px;border-radius:2px;flex:none;border:1px solid rgba(255,255,255,.14)}
.part .nm{flex:1;min-width:0;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.part .qt{font:11px/1 var(--mono);color:var(--dim2);flex:none}
.grouphead{font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--dim2);margin:12px 0 4px;padding-left:8px}
.grouphead:first-child{margin-top:0}

#detail{margin-top:10px;padding:11px 12px;border-radius:var(--r);
  background:#0d1117;border:1px solid var(--line2);font-size:12.5px}
#detail h3{margin:0 0 6px;font-size:13px;font-weight:600}
#detail .meta{display:flex;gap:14px;flex-wrap:wrap;color:var(--dim);
  font:11.5px var(--mono);margin-bottom:7px}
#detail p{margin:0;color:var(--dim);line-height:1.5}
#detail .std{margin-top:7px;font:11px var(--mono);color:var(--accent)}

ul.plain{margin:0;padding:0;list-style:none}
ul.plain li{padding:5px 0 5px 15px;position:relative;color:var(--dim);font-size:12.5px;
  border-bottom:1px solid var(--line)}
ul.plain li:last-child{border-bottom:0}
ul.plain li::before{content:"";position:absolute;left:2px;top:12px;width:4px;height:4px;
  border-radius:50%;background:var(--dim2)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{padding:3px 9px;border-radius:6px;background:#161c24;border:1px solid var(--line2);
  font:11.5px var(--mono);color:var(--dim)}
.note{color:var(--dim);font-size:12px;line-height:1.55}
.warn{color:var(--amber);font-size:12px;line-height:1.5;padding:9px 11px;
  background:#1b1509;border:1px solid #4a3a14;border-radius:8px}
.bars{display:flex;flex-direction:column;gap:7px}
.bar{display:grid;grid-template-columns:1fr auto;gap:3px 10px;font-size:12px}
.bar .t{color:var(--dim)}
.bar .n{font:11.5px var(--mono);color:var(--text)}
.bar .track{grid-column:1/-1;height:3px;border-radius:3px;background:var(--line2);
  overflow:hidden}
.bar .fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent))}
footer{padding:14px 18px 26px;color:var(--dim2);font-size:11px}

/* ---------- mobil ---------- */
@media (max-width:980px){
  body{overflow:auto}
  #app{grid-template-columns:1fr;grid-template-rows:auto 70vh auto;
    grid-template-areas:"head" "stage" "panel";height:auto;min-height:100%}
  aside{border-left:0;border-top:1px solid var(--line);overflow:visible}
  header{padding:11px 16px}
  .chips{gap:6px}
  .chip{min-width:62px;padding:4px 9px}
  #dock{bottom:12px;padding:7px;gap:4px}
  .tool{padding:8px 11px}
  .tool span{display:none}
  .tool.keep span{display:inline}
  .slide input{width:88px}
  #scalebar{bottom:92px;left:14px}
  section{padding:15px 16px}
}
</style>
</head>
<body>
<div id="app">

  <header>
    <div class="title">
      <div class="eyebrow">{{ ui.eyebrow }}</div>
      <h1>{{ identity.product_name }}</h1>
      <div class="subtitle">{{ identity.type_designation or identity.category }}</div>
    </div>
    <div class="chips">
      {%- for c in chips %}
      <div class="chip"><b>{{ c.value }}</b><span>{{ c.label }}</span></div>
      {%- endfor %}
      {%- if cad.representative %}
      <span class="badge rep">{{ ui.representative }}</span>
      {%- endif %}
    </div>
  </header>

  <div id="stage">
    <canvas id="view"></canvas>
    <div id="overlay"><svg id="leaders"></svg></div>
    <div id="hint">{{ ui.hint }}</div>
    <div id="scalebar"><div class="bar" id="sbar"></div><span id="slen">—</span></div>

    <div id="loader" class="indeterminate">
      <div class="ring"></div>
      <div id="track"><div id="fill"></div></div>
      <p id="lpct">{{ ui.loading }}</p>
      <p id="lphase"></p>
    </div>

    <div id="dock">
      <button class="tool keep" id="t-explode" title="E">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
          <rect x="9.5" y="9.5" width="5" height="5" rx="1"/></svg>
        <span id="explode-label">{{ ui.explode }}</span></button>
      <div class="slide">
        <input type="range" id="slider" min="0" max="100" value="0" aria-label="{{ ui.explode }}">
        <b id="pct">0%</b>
      </div>
      <div class="sep"></div>
      <button class="tool" id="t-xray" title="X">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.4"/></svg>
        <span>{{ ui.xray }}</span></button>
      <button class="tool" id="t-photo" title="P" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 16l5-5 4 4 3-3 6 6"/><circle cx="8.5" cy="9.5" r="1.4"/></svg>
        <span>{{ ui.photo_texture }}</span></button>
      <button class="tool" id="t-labels" title="L">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M4 7h10M4 12h16M4 17h7"/></svg>
        <span>{{ ui.labels }}</span></button>
      <button class="tool" id="t-spin" title="Space">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4h-4"/></svg>
        <span>{{ ui.spin }}</span></button>
      <div class="sep"></div>
      <button class="tool" id="t-reset" title="R">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M12 4v4M12 16v4M4 12h4M16 12h4"/>
          <circle cx="12" cy="12" r="2.2"/></svg><span>{{ ui.reset }}</span></button>
{# "Görüntü al" kaldırıldı: tarayıcının kendi ekran görüntüsü aynı işi
   yapıyor, kumanda şeridinde yer açmak ise mobilde düğmelerin sığmasını
   sağlıyor. Klavye kısayolu da kaldırıldı. #}
      <button class="tool" id="t-share">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M10 13.5 14 10M9 7.5l2.6-2.6a3.7 3.7 0 0 1 5.2 5.2L14.5 12.5"/>
          <path d="M15 16.5l-2.6 2.6a3.7 3.7 0 0 1-5.2-5.2L9.5 11.5"/></svg>
        <span id="share-label">{{ ui.share }}</span></button>
      <button class="tool" id="t-full" title="F">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round"><path d="M4 9V4h5M20 15v5h-5M20 9V4h-5M4 15v5h5"/></svg>
        <span>{{ ui.fullscreen }}</span></button>
    </div>
  </div>

  <aside>
{# Müşteri fotoğrafı galerisi kaldırıldı. Fotoğraf artık yan panelde ikinci
   kez gösterilmiyor; ZATEN 3B modelin üzerinde yansıtılıyor (bkz. fotoğraf
   projeksiyonu). Aynı görseli iki kez göstermek paneli şişiriyor ve gözü
   asıl üründen alıyordu. Dosyalar pakette duruyor — projeksiyon dokusu
   onlardan okunuyor. #}
    {%- if identity.summary %}
    <section>
      <h2>{{ ui.summary }}</h2>
      <p class="caption">{{ identity.summary }}</p>
    </section>
    {%- endif %}

    {%- if cad.representative %}
    <section><p class="warn">{{ ui.representative_note }}</p></section>
    {%- endif %}

    {%- if specs %}
    <section>
      <h2>{{ ui.specs }}</h2>
      <table>
        {%- for s in specs %}
        <tr><td class="k">{{ s.label }}</td><td class="v">{{ s.value }}</td></tr>
        {%- endfor %}
        {%- if spec.temperature_range %}
        <tr><td class="k">Sıcaklık aralığı</td><td class="v">{{ spec.temperature_range }}</td></tr>
        {%- endif %}
      </table>
    </section>
    {%- endif %}

    {%- if parts %}
    <section>
      <h2>{{ ui.parts }} <span style="color:var(--dim2)">· {{ parts|length }}</span></h2>
      <div id="partlist"></div>
      <div id="detail" hidden></div>
    </section>
    {%- endif %}

    {%- if materials %}
    <section>
      <h2>{{ ui.materials }}</h2>
      <div class="bars" id="matbars"></div>
    </section>
    {%- endif %}

    <section>
      <h2>{{ ui.model_info }}</h2>
      <table>
        <tr><td class="k">{{ ui.dimensions }}</td><td class="v">
          {{ validation.size_mm[0]|round(0)|int }} × {{ validation.size_mm[1]|round(0)|int }} × {{ validation.size_mm[2]|round(0)|int }} mm</td></tr>
        {%- if validation.mass_g %}
        <tr><td class="k">{{ ui.total_mass }}</td><td class="v">
          {{ (validation.mass_g / 1000)|round(2) }} kg</td></tr>
        {%- endif %}
        <tr><td class="k">Parça / örnek</td><td class="v">
          {{ validation.parts }} / {{ validation.instances }}</td></tr>
        {%- if validation.parts %}
        <tr><td class="k">Katı doğrulama</td><td class="v"
          style="color:{{ 'var(--ok)' if validation.all_solid else 'var(--amber)' }}">
          {{ validation.solid_parts }}/{{ validation.parts }} {{ ui.solid }}</td></tr>
        {%- endif %}
        <tr><td class="k">Model kaynağı</td><td class="v">{{ cad.source }}</td></tr>
      </table>
      {%- if cad.match_reason %}
      <p class="caption" style="margin-top:9px">{{ cad.match_reason }}</p>
      {%- endif %}
      {%- for n in cad.notes %}
      <p class="caption">{{ n }}</p>
      {%- endfor %}
    </section>

    {%- if standard_parts %}
    <section>
      <h2>{{ ui.standard_parts }}</h2>
      <ul class="plain">{% for p in standard_parts %}<li>{{ p }}</li>{% endfor %}</ul>
    </section>
    {%- endif %}

    {%- if applications %}
    <section>
      <h2>{{ ui.applications }}</h2>
      <ul class="plain">{% for a in applications %}<li>{{ a }}</li>{% endfor %}</ul>
    </section>
    {%- endif %}

    {%- if standards %}
    <section>
      <h2>{{ ui.standards }}</h2>
      <div class="tags">{% for s in standards %}<span class="tag">{{ s }}</span>{% endfor %}</div>
    </section>
    {%- endif %}

